{
  "name": "unfold-nav",
  "version": "0.1.1",
  "description": "A dependency-free Web Component that unfolds a compact site map around a navigation button.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/unfold-nav.umd.cjs",
  "module": "./dist/unfold-nav.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/unfold-nav.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/unfold-nav.umd.cjs"
      },
      "default": "./dist/unfold-nav.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-types.mjs",
    "build:showcase": "vite build --mode showcase",
    "preview:showcase": "vite preview --mode showcase --outDir showcase-dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:package": "node scripts/check-package.mjs",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run test:package"
  },
  "keywords": [
    "navigation",
    "radial-menu",
    "marking-menu",
    "web-component",
    "custom-element"
  ],
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "lucide": "^1.49.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikoKaranatsios/unfold-nav.git"
  },
  "homepage": "https://unfold-nav.romagnolo.eu",
  "bugs": {
    "url": "https://github.com/NikoKaranatsios/unfold-nav/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@12.8.1"
}
